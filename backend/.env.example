DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Production (Railway)
DATABASE_URL=postgresql://user:password@host:5432/dbname
ALLOWED_HOSTS=your-domain.railway.app

# AI
ANTHROPIC_API_KEY=your-anthropic-api-key

# CORS
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Email (SMTP)
# Development: EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend (default)
# Production:  EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@fizika-platform.uz

# Eskiz.uz SMS
ESKIZ_EMAIL=your-eskiz-account@email.com
ESKIZ_PASSWORD=your-eskiz-password
ESKIZ_FROM=4546
